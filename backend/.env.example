# ============================================================
# Affilytics Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Run `bun run setup` to auto-generate BUN_ENCRYPTION_KEY.
# NEVER commit .env to git.
# ============================================================

# Required: 64-character hex string (32 bytes) for AES-256-GCM encryption
# Generate with: bun run setup
# WARNING: Losing this key makes stored FB tokens unreadable (disconnected state).
BUN_ENCRYPTION_KEY=

# Optional: SQLite database file path (default: data/affilytics.db)
DATABASE_URL=data/affilytics.db

# Optional: Port to listen on (default: 3000)
# PORT=3000

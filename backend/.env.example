# ============================================================
# Affilytics Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Run `bun run setup` to auto-generate BUN_ENCRYPTION_KEY.
# NEVER commit .env to git.
# ============================================================

# Required: 64-character hex string (32 bytes) for AES-256-GCM encryption
# Generate with: bun run setup
# WARNING: Losing this key makes stored FB tokens unreadable (disconnected state).
BUN_ENCRYPTION_KEY=

# Optional: SQLite database file path (default: data/affilytics.db)
DATABASE_URL=data/affilytics.db

# Optional: Port to listen on (default: 3000)
# PORT=3000

# ============================================================
# Facebook OAuth — Page-Connect Flow (Dev Mode)
# ============================================================
# These are only needed for the OAuth Page-connect flow
# (GET /api/settings/fb-oauth/authorize → callback).
# The app stays in Development Mode for Phase 1; App Review for
# Advanced Access (pages_manage_posts) is a Phase 5 deliverable.
#
# How to get these values:
# 1. Go to https://developers.facebook.com/apps
# 2. Create a new app (or reuse an existing one) — keep it in Development Mode.
# 3. Add the "Facebook Login" product.
# 4. Under Facebook Login → Settings → Valid OAuth Redirect URIs, register
#    the exact callback URL below.
# 5. Copy App ID and App Secret from App Settings → Basic.
#
# WARNING: FB_APP_SECRET must NEVER be committed, logged, or returned in
# any API response. It is read server-side only inside requireFbOAuthConfig().

FB_APP_ID=
FB_APP_SECRET=
FB_OAUTH_REDIRECT_URI=http://localhost:3000/api/settings/fb-oauth/callback

# FB_PAGE_ID (optional): the id of the Facebook Page to connect. Only needed when the
# operator's account administers MORE THAN ONE Page — the OAuth callback uses it to pick
# the right Page instead of guessing. Leave blank if you administer a single Page.
FB_PAGE_ID=
